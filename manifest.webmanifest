{
  "id": "./",
  "name": "Kiln — documents, fired up",
  "short_name": "Kiln",
  "description": "A complete word processor in your browser. Open and save .docx, export PDF, track changes, templates and more. Works offline; your documents stay on your device.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#2b579a",
  "theme_color": "#2b579a",
  "categories": ["productivity", "utilities", "education"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "docs/editor.png", "sizes": "2160x1320", "type": "image/png", "form_factor": "wide", "label": "Editing a newsletter in Kiln" },
    { "src": "docs/start-screen.png", "sizes": "2160x1320", "type": "image/png", "form_factor": "wide", "label": "Start screen with your documents and templates" },
    { "src": "docs/review.png", "sizes": "2160x1320", "type": "image/png", "form_factor": "wide", "label": "Track changes, comments and footnotes" }
  ],
  "shortcuts": [
    { "name": "New blank document", "short_name": "New", "url": "./?action=new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Templates", "url": "./?action=templates", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "file_handlers": [
    {
      "action": "./?action=open-file",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"],
        "text/html": [".html", ".htm"]
      },
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] }
}
